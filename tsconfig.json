{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "sourceMap": true,
    "strict": true,
    "rootDir": "./src",
    "typeRoots": ["./node_modules/@types"],
    "pretty": true,
    "declaration": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "removeComments": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "jsx": "react"
  },
  "exclude": ["node_modules", "tests", "dist"]
}
